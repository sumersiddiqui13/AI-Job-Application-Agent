# AI provider (optional until answer generation is enabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agent behavior
MIN_MATCH_SCORE=75
REQUIRE_APPROVAL=true

# Browser / LinkedIn collection
JOB_SEARCH_URL=https://www.linkedin.com/jobs/
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
BROWSER_HEADLESS=false
BROWSER_USER_DATA_DIR=
MAX_JOB_PAGES=3
JOB_COLLECTION_TIMEOUT_MS=15000

# Local storage
DATA_DIR=./data
PROFILE_PATH=./data/profile.json
APPLICATIONS_PATH=./data/applications.json
